{
  "name": "llmq",
  "version": "0.1.0",
  "description": "LLMQ - Heardle-like daily song guessing game (MVP, single song)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "dev": "concurrently -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "build": "npm --prefix web run build",
    "generate:placeholder-audio": "node scripts/generate-placeholder-audio.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
